{
    "name": "iperson1337/opendxp-perspective-editor",
    "license": "GPL-3.0+",
    "type": "opendxp-bundle",
    "description": "OpenDXP Perspective Editor (fork: + Object Creation Rules editor)",
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "open-dxp/opendxp": "source",
            "*": "dist"
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "open-dxp/admin-bundle": "^1.0",
        "open-dxp/opendxp": "^1.5",
        "symfony/http-foundation": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.14",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\PerspectiveEditorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\Bundle\\PerspectiveEditorBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "opendxp": {
            "bundles": [
                "OpenDxp\\Bundle\\PerspectiveEditorBundle\\OpenDxpPerspectiveEditorBundle"
            ]
        }
    }
}
